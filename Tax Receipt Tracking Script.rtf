\
/**\
 * Safely resolves a file's parent folder, falling back to root.\
 */\
function getParentFolder(file) \{\
  const parents = file.getParents();\
  return parents.hasNext() ? parents.next() : DriveApp.getRootFolder();\
\}\
\
/**\
 * Builds the receipt ID and formatted issue date string.\
 */\
function buildReceiptMeta() \{\
  const today        = new Date();\
  const mm           = ('0' + (today.getMonth() + 1)).slice(-2);\
  const dd           = ('0' + today.getDate()).slice(-2);\
  const yy           = today.getFullYear().toString().slice(-2);\
  const rand         = Math.floor(1000 + Math.random() * 9000);\
  const receiptId    = `$\{mm\}_$\{dd\}_$\{yy\}_$\{rand\}`;\
  const issueDateStr = `$\{mm\}/$\{dd\}/$\{today.getFullYear()\}`;\
  return \{ receiptId, issueDateStr \};\
\}\
\
/**\
 * Builds the output file name from donor info and receipt metadata.\
 */\
function buildFileName(donorName, donDate, receiptId) \{\
  const safeName  = donorName.replace(/[^a-zA-Z0-9]/g, '_');\
  const parts     = donDate.split('/');\
  const dateStamp = `$\{parts[0]\}$\{parts[1]\}$\{parts[2]\}`;\
  return `KYO_Charitable_Tax_Receipt_$\{safeName\}_$\{dateStamp\}_$\{receiptId\}`;\
\}\
\
/**\
 * Copies the template, replaces all placeholders, saves and closes.\
 */\
function copyAndFill(originalFile, parentFolder, newName, data, issueDateStr, receiptId) \{\
  const newFile = originalFile.makeCopy(newName, parentFolder);\
  const newDoc  = DocumentApp.openById(newFile.getId());\
  const body    = newDoc.getBody();\
\
  const replacements = \{\
    '\{\{DONATION_DATE\}\}':      data.donDate,\
    '\{\{RECEIPT_ISSUE_DATE\}\}': issueDateStr,\
    '\{\{DONOR_NAME\}\}':         data.donorName,\
    '\{\{DONOR_ADDRESS\}\}':      data.donorAddress,\
    '\{\{DONATION_TYPE\}\}':      data.donationType,\
    '\{\{DONATION_AMOUNT\}\}':    data.amount,\
    '\{\{ADVANTAGE_RECEIVED\}\}': data.advantage,\
    '\{\{ELIGIBLE_AMOUNT\}\}':    data.eligible,\
    '\{\{RECEIPT_ID\}\}':         receiptId\
  \};\
\
  const missing = [];\
\
  for (const [placeholder, value] of Object.entries(replacements)) \{\
    const before = body.getText();\
    body.replaceText(placeholder, value);\
    if (body.getText() === before) missing.push(placeholder);\
  \}\
\
  newDoc.saveAndClose();\
\
  if (missing.length > 0) \{\
    console.warn(`[copyAndFill] Missing placeholders: $\{missing.join(', ')\}`);\
  \}\
\
  return newFile;\
\}\
\
/**\
 * Exports the filled receipt as a PDF and sends it via Gmail.\
 * The email is sent from the authenticated user's Google account.\
 */\
function sendReceiptByEmail(file, data, issueDateStr) \{\
  // Export the Google Doc as a PDF blob\
  const docId      = file.getId();\
  const exportUrl  = `https://docs.google.com/document/d/$\{docId\}/export?format=pdf`;\
  const token      = ScriptApp.getOAuthToken();\
  const response   = UrlFetchApp.fetch(exportUrl, \{\
    headers: \{ Authorization: `Bearer $\{token\}` \}\
  \});\
  const pdfBlob = response.getBlob().setName(`$\{file.getName()\}.pdf`);\
\
  const subject = `Charitable Donation Receipt \'96 $\{data.donorName\} ($\{issueDateStr\})`;\
  const body    = [\
    `Dear $\{data.donorName\},`,\
    '',\
    'Please find attached your official charitable donation receipt.',\
    '',\
    `  Donation Date:     $\{data.donDate\}`,\
    `  Donation Type:     $\{data.donationType\}`,\
    `  Donation Amount:   $$\{data.amount\}`,\
    `  Advantage Received: $$\{data.advantage\}`,\
    `  Eligible Amount:   $$\{data.eligible\}`,\
    '',\
    'Thank you for your generous contribution.',\
    '',\
    'Sincerely,',\
    Session.getActiveUser().getEmail()\
  ].join('\\n');\
\
  GmailApp.sendEmail(data.recipientEmail, subject, body, \{\
    attachments: [pdfBlob],\
    name: 'KYO Charitable Receipts'\
  \});\
\}\
\
/**\
 * Appends a row to the tracking Google Sheet.\
 */\
function logToSheet(data, issueDateStr, receiptUrl) \{\
  const sheet = SpreadsheetApp.openById(TRACKING_SHEET_ID).getActiveSheet();\
  sheet.appendRow([\
    issueDateStr,\
    data.donorName,\
    data.amount,\
    data.advantage,\
    data.eligible,\
    data.donorAddress,\
    receiptUrl\
  ]);\
\}}
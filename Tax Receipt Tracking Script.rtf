      if (errEl)   errEl.textContent = msg;\
      if (inputEl) inputEl.classList.toggle('error', !!msg);\
    \}\
\
    function clearErrors() \{\
      ['donDate', 'donorName', 'donorAddress', 'donationType', 'amount', 'advantage', 'recipientEmail']\
